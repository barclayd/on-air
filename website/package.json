{
  "name": "on-air-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "build": "NODE_ENV=production bun scripts/build.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
