// Static-assets-only Worker: `bun run build` prerenders the site into dist/,
// and Cloudflare serves it without running any Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "on-air",
  "compatibility_date": "2026-10-01",
  // Wrangler runs this before deploy, so Workers Builds needs no build command of its own.
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./dist"
  },
  // Mirrors the dashboard's preview variable; Wrangler fails preview builds when they differ.
  "previews": {
    "vars": {
      "BUN_VERSION": "1.4.0"
    }
  }
}
