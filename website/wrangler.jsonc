// Static-assets-only Worker: `bun run build` prerenders the site into dist/,
// and Cloudflare serves it without running any Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "on-air-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  }
}
